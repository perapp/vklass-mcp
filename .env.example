# Public HTTPS origin used as the OAuth issuer. Change before deployment.
VKLASS_PUBLIC_BASE_URL=https://vklass.example.com
VKLASS_ALLOWED_HOSTS=vklass.example.com,localhost:*,127.0.0.1:*,vklass-mcp:*
VKLASS_HOST=0.0.0.0
VKLASS_PORT=8000
VKLASS_DATA_DIR=/data
VKLASS_ORGANISATION_ID=190
VKLASS_STATE_KEY_FILE=/run/secrets/state-key
VKLASS_SYNC_INTERVAL_SECONDS=1800
VKLASS_KEEPALIVE_INTERVAL_SECONDS=600
VKLASS_CALENDAR_PAST_DAYS=14
VKLASS_CALENDAR_FUTURE_DAYS=120
VKLASS_AUTHORIZATION_CODE_TTL_SECONDS=300
VKLASS_ACCESS_TOKEN_TTL_SECONDS=3600
VKLASS_REFRESH_TOKEN_TTL_SECONDS=2592000
VKLASS_MAX_PENDING_AUTHORIZATIONS=100
VKLASS_MAX_CONCURRENT_BANKID_FLOWS=4
VKLASS_MAX_RESIDENT_USER_SERVICES=100
VKLASS_LOG_LEVEL=INFO
