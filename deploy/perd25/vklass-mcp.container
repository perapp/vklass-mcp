[Unit]
Description=Public multi-user Vklass MCP server
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/vklass-mcp:latest
Pull=never
ContainerName=vklass-mcp
LogDriver=journald
# Only the host-level perapp-edge proxy can reach this HTTP endpoint.
PublishPort=127.0.0.1:8787:8000
Environment=VKLASS_PUBLIC_BASE_URL=https://vklass.perapp.dev
Environment=VKLASS_ALLOWED_HOSTS=vklass.perapp.dev,localhost:*,127.0.0.1:*
Environment=VKLASS_DATA_DIR=/data
Environment=VKLASS_STATE_KEY_FILE=/run/secrets/state-key
Environment=VKLASS_ORGANISATION_ID=190
Environment=VKLASS_LOG_LEVEL=INFO
Secret=vklass-mcp-state-key,type=mount,target=state-key,uid=10001,gid=10001,mode=0400
Volume=%h/.local/share/vklass-mcp:/data:Z
User=10001
Group=10001
UserNS=keep-id:uid=10001,gid=10001
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
PidsLimit=256
HealthCmd=vklass-mcp-healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=5s
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
